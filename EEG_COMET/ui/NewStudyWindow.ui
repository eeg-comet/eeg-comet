   <string notr="true">QWidget#Form {
    background-color: #f5f7fa;
}
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a90d9, stop:1 #357abd);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5a9fe9, stop:1 #4589cd);
}
QPushButton:pressed {
    background-color: #2a5a8d;
}
QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}
QLineEdit {
    border: 2px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: white;
}
QLineEdit:focus {
    border-color: #4a90d9;
}
QLineEdit:disabled {
    background-color: #ecf0f1;
    color: #95a5a6;
}
QComboBox {
    border: 2px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: white;
}
QComboBox:focus {
    border-color: #4a90d9;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}
QRadioButton, QCheckBox {
    spacing: 8px;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
QListWidget {
    border: 2px solid #d0d7de;
    border-radius: 6px;
    background-color: white;
}
QListWidget:focus {
    border-color: #4a90d9;
}
Line {
