QMainWindow {
    background-color: #f5f7fa;
}
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a90d9, stop:1 #357abd);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5a9fe9, stop:1 #4589cd);
}
QPushButton:pressed {
    background-color: #2a5a8d;
}
QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}
QTabWidget::pane {
    border: 1px solid #d0d7de;
    border-radius: 8px;
    background-color: white;
    padding: 10px;
}
QTabBar::tab {
    background-color: #e8eef4;
    color: #34495e;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: bold;
}
QTabBar::tab:selected {
    background-color: #4a90d9;
    color: white;
}
QTabBar::tab:hover:!selected {
    background-color: #d0dae8;
}
QLineEdit {
    border: 2px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: white;
}
QLineEdit:focus {
    border-color: #4a90d9;
}
QLineEdit:disabled {
    background-color: #ecf0f1;
    color: #95a5a6;
}
QComboBox {
    border: 2px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: white;
}
QComboBox:focus {
    border-color: #4a90d9;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}
QRadioButton, QCheckBox {
    spacing: 8px;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
QScrollArea {
    border: none;
    background-color: transparent;
}
QSpinBox {
    border: 2px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: white;
}
QSpinBox:focus {
    border-color: #4a90d9;
}
QSlider::groove:horizontal {
    border: 1px solid #bdc3c7;
    height: 8px;
    background: #ecf0f1;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #4a90d9;
    border: none;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #357abd;
}
Line {
    color: #d0d7de;
}
